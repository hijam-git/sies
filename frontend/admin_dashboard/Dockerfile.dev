# Development image — Vite dev server with HMR. The source tree is bind-mounted
# over /app by docker-compose.dev.yml, so the COPY below only seeds the image
# for a run without the mount.
FROM node:20-alpine

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install

COPY . .

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
