# ─────────────────────────────────────────────────────────────────────────────
# Traefik environment — production only
#
#   cp traefik/traefik.env.example traefik/traefik.env
#   chmod 600 traefik/traefik.env
#
# traefik.env is GITIGNORED. Only this .example is committed.
#
# The same variables also live in .env.production, which is what the normal
# `docker compose -f docker-compose.prod.yml --env-file .env.production` run
# uses. This separate file exists so Traefik can be brought up on its own during
# a certificate emergency without loading the application's database password
# into that shell:
#
#   docker compose -f docker-compose.prod.yml --env-file traefik/traefik.env \
#     up -d traefik
#
# Keep the two files in agreement. scripts/health_check.sh warns when they drift.
# ─────────────────────────────────────────────────────────────────────────────

# Public hostname the certificate is issued for, and the Host() every router
# matches on.
# Wrong value: Let's Encrypt fails the HTTP-01 challenge and every request is
# answered with Traefik's self-signed default certificate, which browsers refuse
# outright. It also means no router matches, so the answer is a bare 404.
DOMAIN=sies.example.com

# Where Let's Encrypt sends expiry warnings and revocation notices.
# Must be a mailbox somebody reads. A dead address is not rejected at issue
# time — you simply never learn that renewal has been failing for 80 days.
ACME_EMAIL=admin@example.com

# ACME account key + certificate store, as a path INSIDE the container. Backed
# by the `traefik-acme` named volume (docker-compose.prod.yml).
# If this path is not persisted, every restart requests brand-new certificates,
# and Let's Encrypt's limit of 5 duplicate certificates per domain per week
# locks the hostname out for days.
ACME_STORAGE=/letsencrypt/acme.json

# Let's Encrypt STAGING directory URL, for getting DNS right without spending
# the weekly quota. Staging certificates are untrusted by browsers but are
# effectively unlimited.
#   https://acme-staging-v02.api.letsencrypt.org/directory
# Leave EMPTY for real certificates.
# Moving from staging to production needs the acme volume deleted first, or
# Traefik keeps serving the staging certificate it already holds:
#   docker volume rm sies_traefik-acme
ACME_CA_SERVER=

# Traefik's own log verbosity: DEBUG, INFO, WARN, ERROR.
# DEBUG is enormous under real traffic — use it to diagnose a routing problem,
# then put it back, or the disk fills with proxy logs.
TRAEFIK_LOG_LEVEL=INFO

# Dashboard credentials in htpasswd format, with every `$` doubled to `$$`
# because Compose reads a single `$` as the start of a variable.
#
#   htpasswd -nbB admin 'your-password' | sed -e 's/\$/\$\$/g'
#
# Left at the placeholder below, the dashboard is guarded by a password written
# in a public repository — i.e. not guarded. The dashboard also binds to
# 127.0.0.1 only, so reaching it requires `ssh -L 8080:localhost:8080` first;
# this is the second lock, not the first.
TRAEFIK_DASHBOARD_AUTH=admin:$$REPLACE$$WITH$$YOUR$$OWN$$BCRYPT$$HASH
