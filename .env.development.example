# =============================================================================
# SIES — development environment
#
#   scripts/dev.sh up      copies this file to .env.development if it is missing
#
# Every value below is a WORKING DEV DEFAULT. Copy it, run, and the stack comes
# up: nothing here has to be filled in first. That is deliberate — a first run
# that stops on a missing variable teaches people to paste secrets in a hurry.
#
# NOTHING IN THIS FILE IS A SECRET, and nothing in .env.development may become
# one. These credentials protect a throwaway Postgres container that publishes
# no port. The moment a real key is needed in dev, it goes in your shell, not
# here — this file is committed as .example and read by everyone.
#
# Each variable says what it is and what breaks when it is wrong.
# =============================================================================

# ── Django core ──────────────────────────────────────────────────────────────

# Signs sessions, CSRF tokens and password-reset links. In dev it is a fixed
# literal so a container rebuild does not log you out.
# In PRODUCTION a value like this is a full authentication bypass: anyone who
# has read this repository can forge a session cookie. .env.production.example
# has the generator command.
DJANGO_SECRET_KEY=dev-only-insecure-key-not-for-any-real-deployment

# Django's debug mode: tracebacks in the browser, the browsable DRF API, no
# static-file manifest requirement.
# On in production leaks settings, SQL and file paths on any 500 page.
DEBUG=1

# Hostnames Django will answer for. A request whose Host header is not in this
# list gets 400 Bad Request — which is what you see if you add a container and
# forget to list its name.
# `sies-backend` is here because the healthcheck and the deploy probe call the
# container by its own name.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,sies-backend,sies-backend-dev

# Origins the browser may make cross-origin XHR from, enforced by
# django-cors-headers. In dev everything arrives through Traefik on :5000, so
# strictly only that entry is needed; the Vite ports are listed for the case of
# running the SPA outside Docker.
# Wrong: every API call from the SPA fails in the browser with a CORS error
# while curl against the same URL works perfectly — the classic confusing pair.
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5173,http://127.0.0.1:5173

# Origins trusted to send an unsafe method with a CSRF cookie. This is a
# SEPARATE list from CORS and Django checks it separately.
# Wrong: the Django admin login at /admin/ returns "CSRF verification failed"
# while the JWT API keeps working, because the API does not use CSRF.
CSRF_TRUSTED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# The canonical public URL of this deployment. Used to build absolute links in
# emails, printed receipts and PDF headers.
# Wrong: receipts and reminders carry a link nobody can open.
SITE_URL=http://localhost:5000

# ── Locale and time ──────────────────────────────────────────────────────────

# Bangla is the default UI language (CLAUDE.md §8). The SPA has its own bn/en
# toggle; this governs Django-side strings, admin, and DRF error messages.
LANGUAGE_CODE=bn

# Everything is stored UTC and rendered Dhaka (docs/01 §9). This must match
# CELERY_TIMEZONE exactly.
# Wrong: the "1st of the month" fee-generation job fires on the 31st for six
# hours, raising a month of fees against the wrong month.
TIME_ZONE=Asia/Dhaka
CELERY_TIMEZONE=Asia/Dhaka

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# These four are read by BOTH Django and the postgres container in
# docker-compose.dev.yml, so a change here needs `scripts/dev.sh reset` — the
# container only reads them when it initialises an empty data directory, and
# will otherwise keep the old credentials while Django uses the new ones.

DB_ENGINE=django.db.backends.postgresql
DB_NAME=sies_dev
DB_USER=sies
DB_PASSWORD=sies_dev_password

# Service name on sies-network. docker-compose.dev.yml overrides this to
# `sies-db` anyway; it is here so `manage.py` run from your own shell also works.
# Wrong: connection refused, or the far worse case of connecting to a *different*
# database that happens to exist.
DB_HOST=sies-db
DB_PORT=5432

# Seconds Django keeps a database connection open between requests. 0 means a
# fresh connection per request, which is what you want in dev with autoreload:
# a persistent connection held by a dying worker blocks the next migration.
DB_CONN_MAX_AGE=0

# ── Redis and Celery ─────────────────────────────────────────────────────────
# Redis is a BROKER AND NOTHING MORE (CLAUDE.md §1). There is no cache layer.
# Separate logical databases so `redis-cli -n 2 flushdb` on the queue cannot
# also wipe an OTP.

# Short-lived operational keys only: OTPs, idempotency keys on a payment POST.
# If flushing this would lose something that matters, it was in the wrong store.
REDIS_URL=redis://sies-redis:6379/0

# Where Celery tasks are queued. Wrong: `dev.sh up` looks perfectly healthy and
# no background job ever runs — beat publishes into one database while the
# worker listens on another, and neither logs an error.
CELERY_BROKER_URL=redis://sies-redis:6379/2

# Where task return values and states are stored. Same URL as the broker is
# fine at this scale.
CELERY_RESULT_BACKEND=redis://sies-redis:6379/2

# Run tasks inline, in-process, instead of queueing them. Tests set this
# themselves (settings.py, Awliaa's pattern); set it to 1 here only to debug a
# task synchronously, and put it back — with it on, nothing proves the worker
# and the queue are actually wired together.
CELERY_TASK_ALWAYS_EAGER=0

# ── Files ────────────────────────────────────────────────────────────────────

# Uploaded student photos, guardian documents, generated PDFs. Backed by the
# `media-dev` volume, so it survives `dev.sh down` but not `dev.sh reset`.
# These are PRIVATE records served through the API behind auth (docs/01 §8),
# never from a public bucket.
MEDIA_ROOT=/app/media
MEDIA_URL=/media/

# Where `collectstatic` writes. In dev, runserver serves app static directly and
# this is barely used; it exists so the same settings module works in both.
STATIC_ROOT=/app/staticfiles
STATIC_URL=/static/

# ── JWT ──────────────────────────────────────────────────────────────────────
# Minutes / days. Read by the SIMPLE_JWT block copied from Awliaa.

# How long an access token is accepted. Long in dev so a debugging session is
# not interrupted; short in production, because a stolen access token cannot be
# revoked before it expires.
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=1440

# How long the refresh token can mint new access tokens — i.e. how long "stay
# logged in" lasts. Too short and a class teacher is re-authenticating mid-register.
JWT_REFRESH_TOKEN_LIFETIME_DAYS=14

# Issue a new refresh token on every refresh and blacklist the old one. On means
# a stolen refresh token stops working as soon as the real user refreshes.
JWT_ROTATE_REFRESH_TOKENS=1

# ── Security toggles ─────────────────────────────────────────────────────────
# All OFF in dev because dev is plain HTTP on :5000. Turn any of them on here
# and the browser refuses to send the session cookie, which presents as "login
# succeeds then immediately logs out".
SECURE_SSL_REDIRECT=0
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0

# ── Gunicorn ─────────────────────────────────────────────────────────────────
# Unused in dev (runserver), present so the variable names are learned in one
# place. See .env.production.example for the sizing rule.
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60

# ── Python ───────────────────────────────────────────────────────────────────
# The Django project root inside the image.
PYTHONPATH=/app

# =============================================================================
# V2 — deliberately absent. Do not add these without a scope decision.
#
# SIES V1 has no caching layer, no rate limiting, no OAuth, no Cloudflare, no
# R2/S3, and no SMS gateway (CLAUDE.md §1, docs/05 §5.4). Each of those is a
# decision, not an oversight, and adding the variable is how the feature sneaks
# back in — settings.py starts reading it, then something starts depending on it.
#
# When V2 arrives, these are the names to use:
#
# SMS_PROVIDER=
# SMS_API_KEY=
# SMS_SENDER_ID=
# SMS_SANDBOX=1
# =============================================================================
