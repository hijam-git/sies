# =============================================================================
# SIES — production environment
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#   # then edit every CHANGE_ME below
#
# .env.production is GITIGNORED and must stay that way. It holds the database
# password and the key that signs every session in the system.
#
# scripts/fresh_deploy.sh and scripts/pull_and_deploy.sh both REFUSE to run
# while any CHANGE_ME remains, so a half-filled file fails at the start of a
# deploy rather than in the middle of one.
#
# Every variable says what it is and what breaks when it is wrong.
# =============================================================================

# ── Identity of this deployment ──────────────────────────────────────────────

# The public hostname. Used by Traefik's Host() rules, by Let's Encrypt, and by
# the deploy probe's Host header (ALLOWED_HOSTS is strict here, so a probe sent
# as `Host: 127.0.0.1` would get a 400 and a healthy container would look dead).
# Wrong: no router matches and every request is a bare 404.
DOMAIN=CHANGE_ME.example.com

# Short name for this box, used in backup filenames. With two servers writing
# to one off-box store, this is the only way to tell whose dump is whose.
THIS_SERVER_NAME=sies-prod

# ── Django core ──────────────────────────────────────────────────────────────

# Signs sessions, CSRF tokens and password-reset links.
#
#   python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
#
# Wrong (or reused from a public example): anyone holding the value can forge a
# session cookie for any user, including a superuser. This is the single most
# damaging value in the file.
# Changing it later invalidates every active session and every password-reset
# link in flight — safe, but everybody is logged out.
DJANGO_SECRET_KEY=CHANGE_ME_run_the_generator_above

# Never 1 in production. On, it renders a full traceback with settings, SQL and
# file paths on every 500 — to whoever triggered the 500.
DEBUG=0

# Hostnames Django answers for. Keep it exact; a wildcard here re-enables the
# Host-header attacks the setting exists to prevent.
# `sies-backend` is required: the container healthcheck and the deploy probe
# address the container by name.
# Wrong: 400 Bad Request on every request, including the healthcheck, so a
# deploy rolls itself back with no obvious cause.
ALLOWED_HOSTS=CHANGE_ME.example.com,sies-backend

# Origins allowed to make cross-origin XHR. The SPA is served from the same
# origin as the API, so in a standard single-domain install this is just the
# site itself. HTTPS only — an http:// entry here is an origin that cannot
# exist once the redirect is on.
CORS_ALLOWED_ORIGINS=https://CHANGE_ME.example.com

# Origins trusted for unsafe methods with a CSRF cookie. A SEPARATE list from
# CORS, checked separately.
# Wrong: /admin/ login fails with "CSRF verification failed" while the JWT API
# is unaffected, because the API does not use CSRF.
CSRF_TRUSTED_ORIGINS=https://CHANGE_ME.example.com

# Canonical URL, used for absolute links in emails, receipts and PDF headers.
# Wrong: printed receipts carry a link nobody can open.
SITE_URL=https://CHANGE_ME.example.com

# ── Locale and time ──────────────────────────────────────────────────────────

LANGUAGE_CODE=bn

# Stored UTC, rendered Dhaka (docs/01 §9). TIME_ZONE and CELERY_TIMEZONE must
# be identical.
# Wrong: the monthly fee-generation job fires on the wrong calendar day for six
# hours a year and raises a month of fees against the wrong month — which is
# money, and has to be reversed by hand.
TIME_ZONE=Asia/Dhaka
CELERY_TIMEZONE=Asia/Dhaka

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Read by Django AND by the postgres container. The container only reads them
# when it initialises an EMPTY data directory: changing DB_PASSWORD on a running
# deployment changes what Django sends but not what Postgres expects, and every
# request then fails authentication. To rotate it, ALTER the role in psql first,
# then edit this file.

DB_ENGINE=django.db.backends.postgresql
DB_NAME=sies
DB_USER=sies

# Generate:  openssl rand -base64 32
# This is the credential to the fee ledger. Never reuse it anywhere else.
DB_PASSWORD=CHANGE_ME_openssl_rand_base64_32

# Service name on sies-network. Postgres publishes no host port; this is the
# only way in.
DB_HOST=sies-db
DB_PORT=5432

# Seconds a database connection is reused between requests. 60 avoids paying
# TCP + TLS + auth on every request.
# Too high and idle gunicorn workers hold connections Postgres has a hard limit
# of (default 100): the symptom is "FATAL: sorry, too many clients already"
# under load that the database itself is coping with easily.
DB_CONN_MAX_AGE=60

# ── Redis and Celery ─────────────────────────────────────────────────────────
# Broker only. There is no cache layer in SIES (CLAUDE.md §1).

REDIS_URL=redis://sies-redis:6379/0
CELERY_BROKER_URL=redis://sies-redis:6379/2
CELERY_RESULT_BACKEND=redis://sies-redis:6379/2

# Must be 0 in production. Set to 1, every task runs inside the web request that
# triggered it: generating a month of fees would block one gunicorn worker for
# minutes and time out the clerk's browser.
CELERY_TASK_ALWAYS_EAGER=0

# ── Files ────────────────────────────────────────────────────────────────────

# Student photos, guardian documents, generated PDFs. Backed by the `media`
# named volume and included in every backup by scripts/auto_backup.sh.
# These are private records served through the API behind auth (docs/01 §8).
# A pg_dump alone is NOT a complete backup of this system.
MEDIA_ROOT=/app/media
MEDIA_URL=/media/

# Where collectstatic writes; served by Django through the /static router.
# Wrong path and the Django admin loads with no CSS, which is the usual first
# sign that collectstatic did not run.
STATIC_ROOT=/app/staticfiles
STATIC_URL=/static/

# ── JWT ──────────────────────────────────────────────────────────────────────

# Minutes an access token is accepted. Short on purpose: an access token cannot
# be revoked, so its lifetime IS the exposure window if one leaks.
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60

# Days a refresh token can mint new access tokens — how long "stay logged in"
# lasts. Too short and a teacher is re-authenticating in the middle of taking a
# register on a phone.
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Rotate the refresh token on every use and blacklist the old one. Keep this on:
# it is what makes a stolen refresh token stop working the moment the real user
# refreshes.
JWT_ROTATE_REFRESH_TOKENS=1

# ── Security toggles ─────────────────────────────────────────────────────────
# All ON. Traefik already redirects :80 to :443, so SECURE_SSL_REDIRECT is the
# second line of defence for anything that reaches Django by another path.

SECURE_SSL_REDIRECT=1

# Cookies over HTTPS only. Off, a session cookie can be captured on any plain
# HTTP request the user is tricked into making.
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1

# Tells Django the connection was HTTPS even though Traefik terminated TLS and
# spoke plain HTTP to the container.
# Missing: Django believes every request is insecure, SECURE_SSL_REDIRECT sends
# an endless redirect to a URL it is already at, and the browser reports a
# redirect loop.
SECURE_PROXY_SSL_HEADER_NAME=HTTP_X_FORWARDED_PROTO
SECURE_PROXY_SSL_HEADER_VALUE=https

# HSTS, in seconds. 31536000 = one year.
# Turn it on ONLY once the certificate is confirmed working: a browser that has
# cached HSTS for this domain cannot be persuaded to connect over HTTP, so a
# later TLS failure locks out every user who has visited before, with no
# click-through.
SECURE_HSTS_SECONDS=31536000

# ── Gunicorn ─────────────────────────────────────────────────────────────────

# (2 × CPU cores) + 1 is the usual starting point. Each worker is a full Python
# process holding its own database connections — see DB_CONN_MAX_AGE.
# Too high on a 2 GB box: the OOM killer picks off workers mid-request, which
# looks like random 502s.
GUNICORN_WORKERS=3

# Seconds before a worker is killed as hung. PDF generation and CSV import are
# Celery jobs, not requests, so nothing legitimate should approach this.
# Raising it to make a slow endpoint "work" hides the real problem and holds a
# worker hostage while it does.
GUNICORN_TIMEOUT=60

# ── Traefik ──────────────────────────────────────────────────────────────────
# Duplicated in traefik/traefik.env so Traefik can be started on its own during
# a certificate emergency. Keep the two in agreement — health_check.sh warns on
# drift.

# Where Let's Encrypt sends expiry and revocation notices. Must be a mailbox
# somebody reads; a dead address is accepted at issue time, and you then never
# learn that renewal has been failing for 80 days.
ACME_EMAIL=CHANGE_ME@example.com

# Certificate store inside the container, on the traefik-acme volume.
# Not persisted: every restart requests new certificates and Let's Encrypt's
# limit of 5 duplicates per domain per week locks the hostname out for days.
ACME_STORAGE=/letsencrypt/acme.json

# Set to https://acme-staging-v02.api.letsencrypt.org/directory while getting
# DNS right — untrusted certificates, but no rate limit. EMPTY for real ones.
ACME_CA_SERVER=

TRAEFIK_LOG_LEVEL=INFO

# Dashboard basic auth, htpasswd format, every $ doubled to $$ for Compose:
#   htpasswd -nbB admin 'your-password' | sed -e 's/\$/\$\$/g'
# The dashboard binds to 127.0.0.1 only, so this is the second lock; reaching it
# needs `ssh -L 8080:localhost:8080` first.
TRAEFIK_DASHBOARD_AUTH=CHANGE_ME_admin:$$bcrypt$$hash$$here

# ── Backups ──────────────────────────────────────────────────────────────────
# scripts/auto_backup.sh. This system holds the fee ledger; backups are not
# optional (CLAUDE.md §3.4).

# Where dumps and media tarballs land on this box.
BACKUP_DIR=/opt/sies/backups

# Retention. Daily copies are pruned to KEEP_DAILY; one dump per ISO week is
# promoted to weekly and pruned to KEEP_WEEKLY.
# Set too low and the window in which somebody notices a bad data import is
# shorter than the window in which they actually do.
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8

# Off-box copy. A backup on the same disk as the database survives a bad
# migration but not a dead server, and the dead server is the case you keep
# backups for.
#
# Leave BACKUP_REMOTE empty to disable it — auto_backup.sh then says loudly, on
# every run, that the only copy is local. That noise is the point.
#
# Format: an rsync/scp destination, e.g.
#   BACKUP_REMOTE=backup@10.0.0.9:/srv/sies-backups
BACKUP_REMOTE=

# SSH key for the above, readable by the user cron runs as. rsync over SSH
# fails silently under cron more often than any other step here, because cron's
# HOME is not the HOME you configured the key in — so name the path explicitly.
BACKUP_REMOTE_SSH_KEY=/var/lib/sies/.ssh/backup_ed25519

# ── Python ───────────────────────────────────────────────────────────────────
PYTHONPATH=/app

# =============================================================================
# V2 — deliberately absent. Do not add these without a scope decision.
#
# No caching layer, no rate limiting, no OAuth/Google, no Cloudflare, no R2/S3,
# no SMS gateway (CLAUDE.md §1, docs/05 §5.4). Each is a decision, not an
# oversight — and adding the variable is how the feature comes back, because
# settings.py starts reading it and something starts depending on it.
#
# When V2 arrives, these are the names to use:
#
# SMS_PROVIDER=
# SMS_API_KEY=
# SMS_SENDER_ID=
# SMS_SANDBOX=0
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare R2 — uploaded files and offsite backups (core/storage.py)
# ─────────────────────────────────────────────────────────────────────────────
#
# Leave these EMPTY and files are written to the media volume, exactly as
# before. Filled, every FileField in the project writes to the bucket instead —
# no migration, no model change.
#
# The media bucket must be PRIVATE: no r2.dev domain, no custom domain. It
# holds students' birth certificates and fee vouchers; links are presigned and
# expire (300 seconds), and documents are streamed
# through an authenticated endpoint. A public bucket would make both pointless.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sies-media
# Optional: only for a non-standard endpoint. Derived from the account id.
R2_ENDPOINT_URL=
# How long a presigned link lives, in seconds.
R2_PRESIGN_TTL=300

# A SEPARATE, private bucket for database dumps. Never the same as R2_BUCKET —
# `backup_to_r2` refuses to run if it is, because a dump in the media bucket is
# every student, guardian phone number and fee record in one file.
R2_BACKUP_BUCKET=sies-backups
# Names the dumps from this machine, so one bucket can hold production,
# staging and a migration box without them vouching for each other.
THIS_SERVER_NAME=
